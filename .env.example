# Neon Postgres — new project for spendtron, separate from curbspec/chomptron.
DATABASE_URL=

# GitHub App — create at https://github.com/settings/apps/new
# Permissions needed: Actions (Read-only), Metadata (Read-only). Nothing else.
# Callback URL: https://<your-deployed-host>/github/callback
# Slug in production is spendtron-app (not "spendtron").
GITHUB_APP_ID=
GITHUB_APP_SLUG=spendtron-app
# The App's private key (.pem), generated in the App's settings page.
# Paste the whole file contents, newlines intact.
GITHUB_APP_PRIVATE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Price ID (not Product ID) for the $99/mo subscription, created in the
# Stripe dashboard. A real Checkout Session is created per-installation at
# request time (lib/billing.js), not a static payment link, so the webhook
# can map the resulting subscription back to an installation_id via
# session/subscription metadata — same pattern as curbspec's checkout.
# Webhook events: checkout.session.completed and customer.subscription.*.
# Legacy — the original $99/mo recurring model. No longer wired into any
# live checkout flow; kept only so the old webhook branch stays harmless
# if it's ever reached. STRIPE_UNLOCK_PRICE_ID below is the current model.
STRIPE_PRICE_ID=

# One-time payment (not a subscription) that unlocks the full fix-diff
# list for an installation. The ranking is always free; the first fix
# diff on every call is always free; this unlocks the rest.
STRIPE_UNLOCK_PRICE_ID=

# Base URL this service is reachable at — used to build the Checkout
# session's success/cancel URLs. https://spendtron.com in production.
APP_BASE_URL=http://localhost:8080

PORT=8080
STRIPE_PORTAL_CONFIG_ID=
